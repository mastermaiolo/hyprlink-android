        <exclude domain="sharedpref" path="hyprlink_secure_prefs_fallback.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude domain="database" path="hyprlink_database" />
        <exclude domain="database" path="hyprlink_database-wal" />
        <exclude domain="database" path="hyprlink_database-shm" />
        <exclude domain="file" path="diagnostics.log" />
